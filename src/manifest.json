{
  "manifest_version": 3,
  "name": "Winnow — Amazon Review Integrity",
  "version": "0.1.0",
  "description": "What the reviews actually say. Analyses Amazon review integrity locally, in your browser. No affiliate links, ever.",
  "_generated": "host_permissions and content_scripts[].matches are generated from src/core/marketplaces.ts by build.mjs. Editing them here has no effect.",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "https://127.0.0.1/*"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "options_ui": {
    "page": "options/ui/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/ui/popup.html",
    "default_title": "Winnow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
